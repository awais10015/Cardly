# ── Database (SQLite, zero-config for local dev) ─────────────────────────────
DB_PROVIDER=sqlite
DATABASE_URL=file:/home/z/my-project/db/custom.db

# ── Auth ─────────────────────────────────────────────────────────────────────
# Session-cookie signing secret (openssl rand -hex 32)
AUTH_SECRET=44bc0e90ab0b33b772d391b8d491d0e352bf45635e5197ece8f388c48f979366
SESSION_TTL_DAYS=30

# ── App ──────────────────────────────────────────────────────────────────────
APP_NAME=Cardly
# APP_URL=                      # optional locally; set to your domain in production
# NEXT_PUBLIC_APP_URL=

# ── Demo account ─────────────────────────────────────────────────────────────
DEMO_MODE=true
DEMO_EMAIL=demo@cardly.app
DEMO_PASSWORD=demo1234

# ── Password-reset e-mail (optional Resend) ──────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=Cardly <onboarding@resend.dev>

# ── Rate limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_MS=60000
