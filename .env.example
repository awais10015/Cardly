# ═══════════════════════════════════════════════════════════════════════
#  Cardly — DUMMY ENVIRONMENT TEMPLATE
#
#  How to use:
#    1) copy this file:            cp .env.example .env
#    2) change the values below    (each one is explained inline)
#    3) restart the app:           npm run dev
#
#  Every variable has a working default, so the app already runs with
#  zero configuration. You only NEED to edit the 🔴 variables when you
#  deploy to production (or when pointing at a managed MongoDB cluster).
# ═══════════════════════════════════════════════════════════════════════

# ────────────────────────── Database (MongoDB) ────────────────────────
# Connection string.
#
#   Local dev (default) — `npm run dev` auto-starts a local mongod on
#   127.0.0.1:27017 (data stored in db/mongo-data/, nothing to install by hand):
MONGODB_URI=mongodb://127.0.0.1:27017
#
#   MongoDB Atlas (free tier works great) — create a cluster at
#   https://cloud.mongodb.com, then paste your URI:
# MONGODB_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# Database name. If the Atlas URI ends with /dbname, that name wins;
# otherwise MONGODB_DB is used (default: cardly).
MONGODB_DB=cardly

# ────────────────────────── Auth / sessions ───────────────────────────
# 🔴 Secret used to sign session cookies. REQUIRED in production — the app
#    refuses to boot without it. Generate a strong one:
#      openssl rand -hex 32
AUTH_SECRET=

# Login session lifetime in days.
SESSION_TTL_DAYS=30

# ────────────────────────── Public URLs ───────────────────────────────
# 🔴 Canonical public origin of your deployment, NO trailing slash.
#    Used for share links, QR codes and password-reset e-mails.
#    Local dev can leave it empty (the request origin is used).
# APP_URL=https://cardly.yourdomain.com

# Same value but readable by the browser — keeps QR codes pointing at
# your real domain. Uncomment in production:
# NEXT_PUBLIC_APP_URL=https://cardly.yourdomain.com

# ────────────────────────── Branding ──────────────────────────────────
# App name shown in e-mails.
APP_NAME=Cardly

# ────────────────────────── Demo mode ─────────────────────────────────
# Instant-demo button on the landing page (one click → seeded account).
# Set to false for real deployments.
DEMO_MODE=true

# Credentials of the auto-created demo account.
DEMO_EMAIL=demo@cardly.app
DEMO_PASSWORD=demo1234

# ────────────────────────── Transactional e-mail ──────────────────────
# Resend API key (https://resend.com). When set, password-reset links are
# e-mailed for real. When empty, the reset link is surfaced in the UI instead
# (handy for local dev). Plain fetch — no extra dependency.
# RESEND_API_KEY=re_YOUR_RESEND_API_KEY_HERE

# Sender identity shown in e-mails. Must be a verified domain in Resend.
# EMAIL_FROM=Cardly <onboarding@resend.dev>

# ────────────────────────── Rate limiting ─────────────────────────────
# Simple in-memory throttle for auth endpoints (login/signup/reset):
# max attempts per IP per window.
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_MS=60000
